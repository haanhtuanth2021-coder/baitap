/* Yêu cầu 4: Ẩn và hiện nút Skip to Main Content khi focus */
.skip {
  position: absolute;
  top: -40px;
  left: 0;
  background: #000;
  color: #fff;
  padding: 8px;
  z-index: 100;
  transition: top 0.3s;
}

.skip:focus {
  top: 0;
}

/* Yêu cầu 5: Định dạng thanh điều hướng (Nav) */
nav {
  background-color: #f4f4f4;
  padding: 15px;
  border-radius: 8px;
  text-align: center;
}

nav ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  justify-content: center;
  gap: 20px;
}

/* Yêu cầu 6: Box Model cho hình ảnh */
img {
  border: 3px solid #ccc;
  padding: 5px;
  border-radius: 10px;
  max-width: 100%;
  height: auto;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

/* Yêu cầu 7 & 8: Grid cho trang Neighborhood và Flex cho Parks */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  justify-content: center;
  align-items: center;
}

.grid img {
  width: 100%;
}

.flex {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  gap: 15px;
}

/* Yêu cầu 9: Hiệu ứng Hover */
img:hover {
  transform: scale(1.05);
  box-shadow: 0 8px 16px rgba(0,0,0,0.2);
}

/* Yêu cầu 10: nth-child selector */
.grid img:nth-child(odd) {
  border-radius: 20px;
  border-color: #4CAF50;
}

.grid img:nth-child(even) {
  border-radius: 0px;
  border-color: #2196F3;
}
