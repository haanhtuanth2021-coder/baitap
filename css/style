body {
  font-family: Arial, sans-serif;
  font-size: 16px;
}

header {
  background-color: #f0f4f8;
}

/* YÊU CẦU 4: Thay đổi nav sử dụng inline-block và width khoảng 80% */
nav {
  background-color: #2c3e50;
  display: inline-block;
  width: 80%;
}

/* YÊU CẦU 5: Dùng descendant selector để định dạng ảnh trong nav có width 10% */
nav img {
  width: 10%;
}

main {
  background-color: #ffffff;
  font-size: 18px;
}
